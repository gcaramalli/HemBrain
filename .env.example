# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Claude connector (server-only, never prefix with NEXT_PUBLIC_)
# Supabase → Project Settings → API → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
# SQL: select id from families;
FAMILY_ID=
# Long random string, e.g. `openssl rand -hex 32`. Connector URL = https://<app>/api/mcp/<MCP_TOKEN>
MCP_TOKEN=

# Optional: in-app AI (scan a receipt, add an event in plain words, read papers).
# One of the two; Anthropic wins if both are set. Billed per use (about a cent per receipt).
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# aistudio.google.com → Get API key. Use a project with billing on: free-tier
# prompts may be used by Google to improve its models. GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: reminders (web push). Generate once: `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/reminders (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=

# Optional: weekly news email (docs/weekly-digest.md). Resend key with sending access to the verified domain.
RESEND_API_KEY=
# DIGEST_FROM="Hembrain <news@hembrain.com>"
# DIGEST_REPLY_TO=hello@hembrain.com
# APP_URL=https://hembrain.vercel.app
